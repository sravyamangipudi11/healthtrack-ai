# LLM provider: groq, gemini, or mock
LLM_PROVIDER=groq

# Add your own key locally. Never commit real credentials.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Gemini alternative
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Authentication
AUTH_ENABLED=true
API_KEYS=replace_me_clinician_key:clinician,replace_me_admin_key:admin

# Cache and logs
CACHE_TTL_SECONDS=3600
LOG_PATH=logs/interactions.jsonl
